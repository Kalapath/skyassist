{
  "schemaVersion": 1,
  "id": "skyassist",
  "version": "${version}",
  "name": "SkyAssist",
  "description": "Display-only Hypixel SkyBlock helper: profit tracking for every activity, Bazaar flipping, price and craft-cost tooltips, talisman planner, dungeon secret finder and puzzle solvers.",
  "authors": ["Kalapath"],
  "contact": {
    "sources": "https://github.com/Kalapath/skyassist",
    "issues": "https://github.com/Kalapath/skyassist/issues"
  },
  "license": "MIT",
  "icon": "assets/skyassist/icon.png",
  "environment": "client",
  "mixins": [
    "skyassist.mixins.json"
  ],
  "entrypoints": {
    "client": ["dev.farmprofit.FarmProfitClient"],
    "modmenu": ["dev.farmprofit.ModMenuIntegration"]
  },
  "recommends": {
    "hypixel-mod-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "${minecraft_dep}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
